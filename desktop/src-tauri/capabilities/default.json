{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for main and renamer windows",
  "windows": ["main", "renamer"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:tray:default",
    "opener:default",
    "dialog:default",
    "notification:default",
    "core:path:default"
  ]
}
